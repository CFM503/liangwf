<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xiaoliangtrader.daily_signal</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/liangwf/XiaoLiangTrader/scripts/run_daily.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/path/to/liangwf/XiaoLiangTrader/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/liangwf/XiaoLiangTrader/logs/launchd_err.log</string>
</dict>
</plist>
